# ---------- Qloo (hackathon key from https://docs.qloo.com - apply via the Qloo Agentic Hackathon form) ----------
# Leave empty to run the whole product on the built-in synthetic fixtures (no network, no keys).
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Force fixtures even when a key is present (1 = fixtures, 0 = live)
QLOO_FIXTURES=0
# 1 = pre-warm the private cache for the suggestion acts at server start (about 60 Qloo requests once per instance)
QLOO_WARM=0

# ---------- LLM (pick ONE free tier; with none set, the deterministic rule planner drives the same tools) ----------
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override for whichever provider is active (e.g. gemini-2.5-flash-lite)
LLM_MODEL=
# Force the rule planner even if a key is present
MOCK_LLM=0
# Daily caps for the hosted LLM (per visitor ip and across all visitors, UTC days). Past the cap the keyless
# rule planner takes over, so a free-tier key can sit on a public deployment without being burned.
AGENT_LLM_RUNS_PER_IP_PER_DAY=20
AGENT_LLM_RUNS_PER_DAY=300
